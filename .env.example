# Postgres runs on 5433 so it never collides with a local install on 5432.
DATABASE_URL=postgres://tiny:tiny@localhost:5433/tiny_museum

# Object storage. "filesystem" locally; set to "s3" with S3_BUCKET once a
# bucket exists. Nothing outside packages/core/src/storage.ts cares which.
STORAGE_DRIVER=filesystem
STORAGE_DIR=./.data/media
# S3_BUCKET=tiny-museum-media
# AWS_REGION=us-east-1

# Local stand-in for CloudFront: the route that serves stored objects.
MEDIA_BASE_URL=http://localhost:3000/api/media

# Signs presigned upload URLs. The value below is a KNOWN, PUBLISHED string —
# it is fine locally and is refused outright in production. Generate a real one:
#   openssl rand -hex 32
SESSION_SECRET=dev-only-change-me-0123456789abcdef

# Where the museum lives, for QR links and email.
PUBLIC_BASE_URL=http://localhost:3000

# Outbound email. "console" logs to stdout; "file" writes to .data/mail.
MAIL_TRANSPORT=console

# How often the worker seals a new museum epoch, in minutes.
EPOCH_INTERVAL_MINUTES=60
