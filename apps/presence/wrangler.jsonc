{
  // Visitors' presence: one Durable Object per room instance (docs/multiplayer-plan.md §4).
  // Locally: `npm run dev`. Deployed: `npm run deploy --workspace @tiny/presence -- --env gamma`
  // (or production); each env is its own Worker, so gamma and production never share rooms.
  "name": "tiny-museum-presence",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // The free plan needs SQLite-backed objects; Room stores nothing.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://192.168.1.66:3000"
  },
  "observability": { "enabled": true },
  // Served at <name>.<account>.workers.dev; uploads get no extra preview addresses.
  "workers_dev": true,
  "preview_urls": false,
  // Bindings and vars are not inherited by environments, so each repeats them.
  "env": {
    "gamma": {
      "durable_objects": {
        "bindings": [{ "name": "ROOM", "class_name": "Room" }]
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://gamma.d1wkk955zsue1z.amplifyapp.com"
      }
    },
    "production": {
      "durable_objects": {
        "bindings": [{ "name": "ROOM", "class_name": "Room" }]
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://tinymuseums.com,https://www.tinymuseums.com,https://main.d1wkk955zsue1z.amplifyapp.com"
      }
    }
  }
}
