DATABASE_URL=postgres://tiny:tiny@localhost:5433/tiny_museum

# "filesystem" locally, "s3" in production.
STORAGE_DRIVER=filesystem
STORAGE_DIR=./.data/media
# S3_BUCKET=tiny-museum-media
# AWS_REGION=us-east-1

MEDIA_BASE_URL=http://localhost:3000/api/media

# Optional. The bucket's CDN origin. When set, /api/media redirects there
# instead of proxying objects through the SSR compute.
MEDIA_ORIGIN_URL=

# Refused in production. Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-only-change-me-0123456789abcdef

PUBLIC_BASE_URL=http://localhost:3000

# "console" or "file"
MAIL_TRANSPORT=console

HALL_OWNER_EMAIL=testing2@example.com

# Signs visitors' presence tickets; shared with the Cloudflare room (apps/presence).
# Generate one with: openssl rand -hex 32
PRESENCE_SECRET=dev-only-presence-0123456789abcdef
# The presence Worker; `npm run dev` runs it locally. Leave empty to turn presence off.
PRESENCE_URL=ws://localhost:8787
