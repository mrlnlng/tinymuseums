# Local Postgres cluster and uploaded media — the S3 stand-in.
.data/

# Secrets. .env.example is committed; nothing else in this family is.
.env
.env.*
!.env.example

# Agent-facing working notes. Kept locally for the coding agents; not part of
# the public repository.
PROJECT.md
DEPLOYMENT.md

# Keys, certificates and credential files — never in this repo.
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
.aws/
credentials
secrets.json
*.secret

node_modules/
.next/
out/
dist/

*.log
npm-debug.log*
coverage/

.DS_Store
Thumbs.db

# Artwork images are proprietary — generated by scripts/prep_assets.py from the
# source art pack and must not be committed. The UI assets (bunny, frame, etc.)
# are fine; only the actual artwork is excluded.
apps/web/public/assets/artwork-*

# The music is a ~2.3MB clip generated by scripts/prep_assets.py, small enough
# to commit alongside the other generated assets so a clone just works.
# The full-length source track stays out, like the source art.

# Tooling runtime state and build caches — operational artifacts, not source.
.omc/
*.tsbuildinfo

# Python bytecode from the asset scripts.
__pycache__/
*.pyc

# Amplify Gen 2. The generated config and the CDK build output are per-deploy
# artifacts; the sharp layer's node_modules is installed during the build.
.amplify/
amplify_outputs.json
